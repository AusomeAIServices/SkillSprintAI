{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsprint.local/schemas/lesson.schema.json",
  "title": "SkillSprint authored lesson",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "status", "title", "durationMinutes", "objective", "steps", "practice", "quiz", "rubric", "provenance"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "published", "retired"] },
    "title": { "type": "string", "minLength": 1 },
    "durationMinutes": { "const": 15 },
    "objective": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": { "type": "object", "required": ["id", "type", "minutes", "title", "text"], "properties": { "id": { "type": "string" }, "type": { "enum": ["recall", "instruction", "practice", "assessment", "reflection"] }, "minutes": { "type": "integer", "minimum": 1 }, "title": { "type": "string" }, "text": { "type": "string" } } }
    },
    "quiz": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "choices", "correctChoiceId", "explanation"], "properties": { "id": { "type": "string" }, "choices": { "type": "array", "minItems": 2 }, "correctChoiceId": { "type": "string" }, "explanation": { "type": "string" } } } },
    "rubric": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "maxScore", "criterion"] } },
    "provenance": { "type": "object", "required": ["contentType", "createdAt", "sourceCheckedAt", "reviewStatus"] }
  }
}
