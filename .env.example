# The M1 learner preview works without an OpenAI key or an external account.
# Local demo APIs require NODE_ENV=development and SKILLSPRINT_LOCAL_DEMO=true.
SKILLSPRINT_LOCAL_DEMO=true
SKILLSPRINT_DB_PATH=.data/skillsprint.sqlite

# Reserved for later milestones; coach remains disabled until explicitly built and evaluated.
OPENAI_API_KEY=
OPENAI_MODEL=
COACH_ENABLED=false
